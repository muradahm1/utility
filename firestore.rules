rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: Only the authenticated user can read or write their own profile
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Calculations history: 
    // - Authenticated users can create new records with their own userId
    // - Authenticated users can read or delete their own calculations
    match /calculations/{calcId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
  }
}
